const KID_PHASES = [3];
const KID_ITEMS = ['p0_i4','p2_i1','p2_i2','p2_i3','p4_i2'];
function phaseVisible(p){ return hasKids || !KID_PHASES.includes(p); }
function itemVisible(p,i){ return phaseVisible(p) && (hasKids || !KID_ITEMS.includes(`p${p}_i${i}`)); }
function visibleIdx(p){ return DATA[lang][p].map((_,i)=>i).filter(i=>itemVisible(p,i)); }
function visiblePhases(){ return DATA[lang].map((_,p)=>p).filter(phaseVisible); }
