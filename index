  const done=!!checked[id];
  const div=document.createElement('div');
  div.id='row-'+id; div.className=rowCls(item.type,done);
  const needHtml=item.need&&item.need!=='—'?`<dt>${t.need_lbl}:</dt><dd>${item.need}</dd>`:'';
  let noHtml='';
  if(item.svc && lang!=='no'){
    const m=id.match(/p(\d+)_i(\d+)/);
    const noItem=DATA.no[+m[1]][+m[2]];
    const q=(noItem.call.match(/«([^»]+)»/)||[])[1];
    if(q) noHtml=`<div class="check-call-no"><span>${t.call_no_lbl||'På norsk:'}</span><div lang="nb" dir="ltr">«${q}»</div></div>`;
  }
  const callHtml=item.call?`<div class="check-call"><strong>${t.call_lbl}</strong>${item.call}${noHtml}</div>`:'';
  const arrow=lang==='ar'?'←':'→';
  const linkHtml=item.link?`<a href="${item.link}" target="_blank" rel="noopener" class="check-link">${t.open_link} ${arrow}</a>`:'';
  const genericAll=['alle','everyone','iedereen','الجميع','herkes'];
  const showFor = item.for && !genericAll.includes(item.for.toLowerCase().trim());
  const forHtml = showFor ? `<span class="check-for">${item.for}</span>` : '';
  div.innerHTML=`<details><summary class="check-summary">
    <div class="check-cb" id="cb-${id}" onclick="event.stopPropagation();toggleCheck('${id}')">
      <svg class="check-cb__tick" width="12" height="9" viewBox="0 0 12 9" fill="none"><path d="M1 4L4.5 7.5L11 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="check-meta-wrap">
      <span class="check-title" id="title-${id}">${item.title}</span>
      <div class="check-sub-line">
        <span class="${done?'tb-badge tb-badge--done':badgeCls(item.type)}" id="badge-${id}">${badgeTxt(item.type,done,t)}</span>
        ${forHtml}
        <span class="check-when">${item.when}</span>
      </div>
    </div>
    <span class="check-arrow">▾</span>
  </summary>
  <div class="check-details">
    <dl><dt>${t.why_lbl}:</dt><dd>${item.why}</dd>${needHtml}</dl>
    <p>${item.desc}</p>
    ${callHtml}${linkHtml}
  </div></details>`;
  // Prevent done rows from expanding
  if(done){
    const summary=div.querySelector('summary');
    if(summary) summary.addEventListener('click', e=>{ if(div.classList.contains('check-row--done')) e.preventDefault(); });
  }
  return div;
}

function buildAll(){
  const d=DATA[lang],t=T[lang];
  for(let p=0;p<d.length;p++){
    const c=document.getElementById('list'+p);
    if(!c) continue;
    c.innerHTML='';
    d[p].forEach((item,i)=>{
      if(!itemVisible(p,i)) return;
      const row=buildRow(item,`p${p}_i${i}`,t);
      c.appendChild(row);
    });
    const tab=document.querySelector(`[data-phase="${p}"]`);
    if(tab) tab.style.display = phaseVisible(p) ? '' : 'none';
  }
  const tl=document.getElementById('phaseTabs');
  if(tl) tl.style.setProperty('--tl-n', visiblePhases().length);
  // Block toggling open on done rows
  document.querySelectorAll('.check-row--done details').forEach(det=>{
    det.removeAttribute('open');
  });
  updateTimeline();
  updateProgress();
  updateNavBtns();
}

function saveChecked(){
  try{
    localStorage.setItem('tb_checked', JSON.stringify(checked));
    localStorage.setItem('tb_lang', lang);
  }catch(e){}
}
function loadChecked(){
  try{
    const s=localStorage.getItem('tb_checked');
    if(s){ const d=JSON.parse(s); Object.assign(checked,d); }
  }catch(e){}
}
function hasSavedProgress(){
  try{
    const s=localStorage.getItem('tb_checked');
    if(!s) return false;
    const d=JSON.parse(s);
    return Object.values(d).some(v=>v);
  }catch(e){ return false; }
}
function getSavedLang(){
  try{ return localStorage.getItem('tb_lang')||'no'; }catch(e){ return 'no'; }
}
function clearProgress(){
  try{
    localStorage.removeItem('tb_checked');
    localStorage.removeItem('tb_lang');
    localStorage.removeItem('tb_kids');
  }catch(e){}
  Object.keys(checked).forEach(k=>delete checked[k]);
}

function toggleCheck(id){
  checked[id]=!checked[id];
  if(!checked[id]) delete checked[id]; // clean up false values
  const t=T[lang],item=getItem(id);
  const row=document.getElementById('row-'+id);
  if(row){
    row.className=rowCls(item.type,checked[id]);
    // Close and lock done rows
    if(checked[id]){
      const det=row.querySelector('details');
      if(det) det.removeAttribute('open');
    }
  }
  const badge=document.getElementById('badge-'+id);
  if(badge){badge.textContent=badgeTxt(item.type,checked[id],t);badge.className=checked[id]?'tb-badge tb-badge--done':badgeCls(item.type);}
  saveChecked();
  updateTimeline();
  updateProgress();
}

function getItem(id){const m=id.match(/p(\d+)_i(\d+)/);return DATA[lang][+m[1]][+m[2]];}

function updateTimeline(){
  const checkSvg=`<svg width="12" height="10" viewBox="0 0 12 10" fill="none"><path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  const defaultDot=[
    '1','2','3',
    `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M6 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>`,
    `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><line x1="12" y1="12" x2="12" y2="16"/><circle cx="12" cy="16" r="1" fill="currentColor"/></svg>`,
    `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`
  ];
  const d=DATA[lang];
  for(let p=0;p<d.length;p++){
    const vis=visibleIdx(p);
    const total=vis.length;
    const done=vis.filter(i=>!!checked[`p${p}_i${i}`]).length;
    const btn=document.querySelector(`[data-phase="${p}"]`);
    const dot=document.getElementById('dot'+p);
    if(!btn||!dot) continue;
    const isComplete = done===total && total>0;
    btn.classList.toggle('complete', isComplete);
    dot.innerHTML = isComplete ? checkSvg : defaultDot[p];
  }
}

function updateProgress(){
  const d=DATA[lang];let total=0,done=0;
  for(let p=0;p<d.length;p++){const vis=visibleIdx(p);total+=vis.length;done+=vis.filter(i=>!!checked[`p${p}_i${i}`]).length;}
  const pct=total>0?Math.round(done/total*100):0;
  const fill=document.getElementById('progressFill');
  if(fill) fill.style.width=pct+'%';
  const label=document.getElementById('progressText');
  const labelWrap=document.getElementById('progressLabel');
  if(labelWrap){
    if(done===0){
      labelWrap.classList.add('hidden');
    } else {
      labelWrap.classList.remove('hidden');
      if(label) label.textContent=T[lang].progress_fn(done,total);
    }
  }
}

function updateNavBtns(){
  const prev=document.getElementById('prevBtn');
  const next=document.getElementById('nextBtn');
  if(!prev||!next) return;
  const t=T[lang];
  prev.disabled=phase===0;
  prev.textContent=t.nav_prev||'← Forrige';
  next.textContent=phase===5?(t.badge_done||'Ferdig'):(t.nav_next||'Neste →');
  next.disabled=phase===5&&Object.values(checked).every(v=>!v);
}

function switchPhase(idx){
  document.querySelectorAll('.phase-section').forEach(s=>s.classList.remove('phase-section--active'));
  document.querySelectorAll('.phase-tl-btn').forEach(b=>b.classList.remove('active'));
  const section=document.getElementById('phase-'+idx);
  if(section) section.classList.add('phase-section--active');
  const btn=document.querySelector(`[data-phase="${idx}"]`);
  if(btn) btn.classList.add('active');
  phase=idx;
  updateNavBtns();
  // Scroll to top of main content smoothly
  const main=document.querySelector('.app-main');
  if(main) main.scrollIntoView({behavior:'smooth',block:'start'});
}

function prevPhase(){ const v=visiblePhases(), k=v.indexOf(phase); if(k>0) switchPhase(v[k-1]); }
function nextPhase(){ const v=visiblePhases(), k=v.indexOf(phase); if(k<v.length-1) switchPhase(v[k+1]); }

function applyLangToApp(l){
  const t=T[l];
  if(!t) return;
  document.querySelectorAll('[data-t]').forEach(el=>{
    const k=el.getAttribute('data-t');
    if(typeof t[k]==='string') el.textContent=t[k];
  });
  document.documentElement.setAttribute('dir',l==='ar'?'rtl':'ltr');
  document.documentElement.lang = l === 'no' ? 'nb' : l;
  showLangNote('appLangNote', l);
  const back=document.getElementById('backBrand');
  if(back && t.back_title){ back.title=t.back_title; back.setAttribute('aria-label',t.back_title); }
  // Update lang-sw buttons
  document.querySelectorAll('.lang-sw__btn').forEach(b=>{
    b.classList.toggle('lang-sw__btn--active', b.getAttribute('onclick').includes(`'${l}'`));
  });
}

function setLang(l){
  lang=l;
  applyLangToApp(l);
  buildAll();
}

// Init: skip welcome if returning user has saved progress
(function(){
  if(hasSavedProgress()){
    const savedLang = getSavedLang();
    lang = savedLang;
    loadKids();
    loadChecked();
    document.getElementById('welcomeScreen').classList.add('hidden');
    document.getElementById('appScreen').classList.add('visible');
    applyLangToApp(savedLang);
    buildAll();
    // Find the first phase that has unchecked items and go there
    const d=DATA[savedLang];
    let startPhase=0;
    for(let p=0;p<d.length;p++){
      if(!phaseVisible(p)) continue;
      const allDone=visibleIdx(p).every(i=>!!checked[`p${p}_i${i}`]);
      if(!allDone){ startPhase=p; break; }
      if(p===d.length-1) startPhase=p;
    }
    switchPhase(startPhase);
  } else {
    updateWelcomeTexts('no');
  }
})();
</script></body></html>
