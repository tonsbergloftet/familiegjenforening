let pendingLang = 'no';
let pendingArrived = null;
let pendingKids = null;

function pickLang(l) {
  pendingLang = l;
  document.querySelectorAll('.lang-pick-btn').forEach(b =>
    b.classList.toggle('selected', b.dataset.lang === l));
  updateWelcomeTexts(l);
  checkStartEnabled();
}

function pickArrived(val) {
  pendingArrived = val;
  document.querySelectorAll('.arrived-btn[data-arrived]').forEach(b =>
    b.classList.toggle('selected', b.dataset.arrived === val));
  checkStartEnabled();
}

function pickKids(val) {
  pendingKids = val;
  document.querySelectorAll('.arrived-btn[data-kids]').forEach(b =>
    b.classList.toggle('selected', b.dataset.kids === val));
  checkStartEnabled();
}

function checkStartEnabled() {
  document.getElementById('startBtn').disabled = !pendingArrived || !pendingKids;
}

function updateWelcomeTexts(l) {
  const w = WelcomeT[l] || WelcomeT.no;
  document.getElementById('wMunicipality').textContent = w.municipality;
  document.getElementById('wTitle').textContent = w.title;
  document.getElementById('wSub').textContent = w.sub;
  document.getElementById('wLangLabel').textContent = w.langLabel;
  document.getElementById('wArrivedLabel').textContent = w.arrivedLabel;
  document.getElementById('wArrivedNo').textContent = w.arrivedNo;
  document.getElementById('wArrivedYes').textContent = w.arrivedYes;
  document.getElementById('wKidsLabel').textContent = w.kidsLabel;
  document.getElementById('wKidsYes').textContent = w.kidsYes;
  document.getElementById('wKidsNo').textContent = w.kidsNo;
  document.getElementById('wStartBtnText').textContent = w.startBtn;
  document.getElementById('wDisclaimer').textContent = w.disclaimer;
  document.documentElement.setAttribute('dir', l === 'ar' ? 'rtl' : 'ltr');
  document.documentElement.lang = l === 'no' ? 'nb' : l;
  showLangNote('wLangNote', l);
}

function startApp() {
  lang = pendingLang;
  hasKids = pendingKids !== 'no';
  saveKids();
  loadChecked();
  const startPhase = pendingArrived === 'yes' ? 1 : 0;
  document.getElementById('welcomeScreen').classList.add('hidden');
  const appScreen = document.getElementById('appScreen');
  appScreen.classList.add('visible');
  applyLangToApp(lang);
  buildAll();
  switchPhase(startPhase);
  window.scrollTo(0, 0);
}

function goBack() {
  document.getElementById('appScreen').classList.remove('visible');
  document.getElementById('welcomeScreen').classList.remove('hidden');
  window.scrollTo(0, 0);
}
function restartApp(){
  const t=T[lang];
  const msg=t.restart_confirm||'Vil du slette alle avkrysninger og starte på nytt?';
  if(!confirm(msg)) return;
  clearProgress();
  document.getElementById('appScreen').classList.remove('visible');
  document.getElementById('welcomeScreen').classList.remove('hidden');
  // Reset welcome form
  pendingLang='no'; pendingArrived=null; pendingKids=null;
  document.querySelectorAll('.lang-pick-btn').forEach(b=>b.classList.toggle('selected',b.dataset.lang==='no'));
  document.querySelectorAll('.arrived-btn').forEach(b=>b.classList.remove('selected'));
  document.getElementById('startBtn').disabled=true;
  updateWelcomeTexts('no');
  window.scrollTo(0,0);
}

